pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Jenkins Pipeline is Building!'
            }
        }
        stage('Test') {
            steps {
                echo 'Jenkins Pipeline is Testing!'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Jenkins Pipeline is Deploying!'
            }
        }
    }
}
